root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,xml,csproj,props,targets,slnx,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Language preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: private fields _camelCase, constants and static readonly PascalCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.static_readonly.symbols = static_readonly
dotnet_naming_rule.static_readonly.style = pascal
dotnet_naming_rule.static_readonly.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

# Rule order matters: constants and static readonly fields before the private-field rule.
dotnet_naming_rule.constants.priority = 1
dotnet_naming_rule.static_readonly.priority = 2
dotnet_naming_rule.private_fields.priority = 3

# ---- Analyzer tuning (dotnet-coding-standards) ----
# ASP.NET Core has no synchronization context; ConfigureAwait(false) is noise here.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
# Library types are public by design: the composition root in the Host wires concrete types.
dotnet_diagnostic.CA1515.severity = none
# Arguments come from DI or the framework; null checks everywhere add nothing.
dotnet_diagnostic.CA1062.severity = none
# Several small related types per file (options and validators, records) is allowed.
dotnet_diagnostic.MA0048.severity = none
# Request/response DTOs expose concrete collection types for clean (de)serialization.
dotnet_diagnostic.MA0016.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none
# Extension methods live next to the framework types they extend.
dotnet_diagnostic.MA0047.severity = none
# Nested types used for options sections and endpoint groupings.
dotnet_diagnostic.CA1034.severity = none
# Uri-typed properties: configuration binds strings.
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA2234.severity = none
# C#-only code base: names that collide with VB keywords ("Error") are fine.
dotnet_diagnostic.CA1716.severity = none
# Result<T>.Success / Result<T>.Failure factories read better than a separate non-generic class.
dotnet_diagnostic.CA1000.severity = none
# Message types, routing keys and error codes are protocol tokens, not user-facing text.
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1308.severity = none
# The consumer pipeline, workers and middleware catch every exception on purpose to classify or log it.
dotnet_diagnostic.CA1031.severity = none
