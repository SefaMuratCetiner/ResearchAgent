<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The RabbitMQ transport: topology (topic exchange, quorum queues, TTL delay queues, DLQs), the confirmed publisher,
    and one listener per consumed contract that feeds deliveries to Research.Shared.Adapters' MessageDispatcher.
    The IConnection comes from Aspire's RabbitMQ client integration.
  -->
  <PropertyGroup>
    <RootNamespace>Research.Providers.RabbitMq</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Research.Shared.Core\Research.Shared.Core.csproj" />
    <ProjectReference Include="..\..\Shared\Research.Shared.Bus\Research.Shared.Bus.csproj" />
    <ProjectReference Include="..\..\Shared\Research.Shared.Contracts\Research.Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
</Project>
