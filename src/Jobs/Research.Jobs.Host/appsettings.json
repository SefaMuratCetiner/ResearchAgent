{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Research.Content.Http": "Information",
        "Research.Content.Llm": "Information",
        "Research.Content.Search": "Information",
        "Research.Content.Documents": "Information",
        "Research.Content.Reports": "Information"
      }
    }
  },
  "ContentLogging": {
    "MaxChars": 64000
  },
  "Messaging": {
    "ServiceName": "jobs",
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 10, 60, 300 ],
    "Prefetch": 16,
    "OutboxBatchSize": 100,
    "OutboxPollIntervalMs": 1000,
    "OutboxMaxAttempts": 20,
    "OutboxMaxRetryDelaySeconds": 300,
    "MessageTimeoutSeconds": 120
  },
  "RabbitMq": {
    "Exchange": "research.events",
    "ShutdownDrainSeconds": 30
  },
  "Jobs": {
    "MaxDuration": "00:05:00",
    "SynthesisReserve": "00:01:30",
    "MinSources": 3,
    "MaxSources": 12,
    "MaxSubQuestions": 5,
    "ResultsPerSearch": 6,
    "TokenBudget": 400000,
    "StepLease": "00:03:00",
    "MaxStepAttempts": 3,
    "SynthesisTopK": 12,
    "QuestionMinLength": 10,
    "QuestionMaxLength": 2000,
    "RecoveryInterval": "00:00:30",
    "DeadlineInterval": "00:00:05",
    "WorkerBatchSize": 50,
    "EventsPollInterval": "00:00:01"
  },
  "AllowedHosts": "*"
}
