    <ProjectReference Include="..\Search\Research.Search.Host\Research.Search.Host.csproj" />
    <ProjectReference Include="..\Fetching\Research.Fetching.Host\Research.Fetching.Host.csproj" />
    <ProjectReference Include="..\Knowledge\Research.Knowledge.Host\Research.Knowledge.Host.csproj" />
    <ProjectReference Include="..\Synthesis\Research.Synthesis.Host\Research.Synthesis.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Valkey" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
  </ItemGroup>
</Project>
