<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <!--
    The local orchestrator (D22): starts Postgres (pgvector), RabbitMQ, Valkey, Azurite, Elasticsearch and Kibana, the schema scripts and every
    service with its replicas. References Bootstrap/Worker entry points and tools only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Research.AppHost</RootNamespace>
    <UserSecretsId>research-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Research.DbScripts\Research.DbScripts.csproj" />
    <ProjectReference Include="..\Services\Jobs\Research.Jobs.Bootstrap\Research.Jobs.Bootstrap.csproj" />
    <ProjectReference Include="..\Services\Jobs\Research.Jobs.Worker\Research.Jobs.Worker.csproj" />
    <ProjectReference Include="..\Services\Planning\Research.Planning.Bootstrap\Research.Planning.Bootstrap.csproj" />
    <ProjectReference Include="..\Services\Search\Research.Search.Bootstrap\Research.Search.Bootstrap.csproj" />
    <ProjectReference Include="..\Services\Fetching\Research.Fetching.Bootstrap\Research.Fetching.Bootstrap.csproj" />
    <ProjectReference Include="..\Services\Knowledge\Research.Knowledge.Bootstrap\Research.Knowledge.Bootstrap.csproj" />
    <ProjectReference Include="..\Services\Synthesis\Research.Synthesis.Bootstrap\Research.Synthesis.Bootstrap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Valkey" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" />
  </ItemGroup>
</Project>
