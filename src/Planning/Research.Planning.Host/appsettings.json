{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Research.Content.Llm": "Information"
      }
    }
  },
  "ContentLogging": {
    "MaxChars": 64000
  },
  "Messaging": {
    "ServiceName": "planning",
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 10, 60, 300 ],
    "Prefetch": 4,
    "MessageTimeoutSeconds": 600
  },
  "RabbitMq": {
    "Exchange": "research.events",
    "ShutdownDrainSeconds": 60
  },
  "Anthropic": {
    "MaxConcurrentRequests": 4,
    "RefusalFallbackModel": "claude-sonnet-5"
  },
  "Planning": {
    "Model": "claude-sonnet-5-5",
    "Effort": "Medium",
    "MaxTokens": 4000,
    "CacheTimeToLive": "1.00:00:00"
  },
  "AllowedHosts": "*"
}
