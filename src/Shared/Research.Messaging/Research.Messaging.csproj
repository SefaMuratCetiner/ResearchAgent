<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The transport-neutral half of messaging: envelopes, trace propagation, the consumer dispatch pipeline (scope,
    actor, timeout, retry classification, poison and exhaustion handling) and the outbox dispatcher loop.
    The broker adapter lives in Research.Providers.RabbitMq, the outbox/inbox SQL in Research.Providers.Postgres.
  -->
  <PropertyGroup>
    <RootNamespace>Research.Messaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Research.SharedKernel\Research.SharedKernel.csproj" />
    <ProjectReference Include="..\Research.Contracts\Research.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
