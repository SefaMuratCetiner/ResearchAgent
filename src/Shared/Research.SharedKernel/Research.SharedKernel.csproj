<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The code every process shares: base entities, Result and errors, the current actor, transaction and messaging
    ports, and the ports for external capabilities (LLM, embeddings, documents, cache). No package references and
    no DI registration code: the Hosts' composition roots wire these types.
  -->
  <PropertyGroup>
    <RootNamespace>Research.SharedKernel</RootNamespace>
  </PropertyGroup>
</Project>
