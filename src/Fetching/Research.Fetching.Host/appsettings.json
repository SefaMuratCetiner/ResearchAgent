{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Research.Content.Documents": "Information"
      }
    }
  },
  "ContentLogging": {
    "MaxChars": 64000
  },
  "Messaging": {
    "ServiceName": "fetching",
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 10, 60, 300 ],
    "Prefetch": 8,
    "OutboxBatchSize": 100,
    "OutboxPollIntervalMs": 1000,
    "MessageTimeoutSeconds": 120
  },
  "RabbitMq": {
    "Exchange": "research.events",
    "ShutdownDrainSeconds": 30
  },
  "Fetching": {
    "MaxBytes": 5242880,
    "MaxRedirects": 5,
    "Timeout": "00:00:20",
    "MinContentChars": 500,
    "MaxContentChars": 200000,
    "UserAgent": "ResearchAgent/1.0 (+https://research.local/bot)",
    "PerDomainConcurrency": 2,
    "RespectRobotsTxt": true,
    "RobotsCacheDuration": "01:00:00",
    "AllowedContentTypes": [ "text/html", "application/xhtml+xml", "text/plain" ]
  },
  "AllowedHosts": "*"
}
