<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Fetching module: downloads one page safely (SSRF guard on every connection, size and redirect limits, robots
    policy, per-domain concurrency), extracts readable text, stores it in blob storage (claim check) and records the
    document. Replies go through the outbox in the same transaction as the document row.
  -->
  <PropertyGroup>
    <RootNamespace>Research.Fetching</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Research.SharedKernel\Research.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Shared\Research.Contracts\Research.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Research.Messaging\Research.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
