{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Research.Content.Http": "Information"
      }
    }
  },
  "ContentLogging": {
    "MaxChars": 64000
  },
  "Messaging": {
    "ServiceName": "knowledge",
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 10, 60, 300 ],
    "Prefetch": 8,
    "OutboxBatchSize": 100,
    "OutboxPollIntervalMs": 1000,
    "OutboxMaxAttempts": 20,
    "OutboxMaxRetryDelaySeconds": 300,
    "MessageTimeoutSeconds": 120
  },
  "RabbitMq": {
    "Exchange": "research.events",
    "ShutdownDrainSeconds": 30
  },
  "Knowledge": {
    "ChunkChars": 1200,
    "ChunkOverlapChars": 200,
    "MaxPassagesPerDocument": 200,
    "EmbeddingBatchSize": 64,
    "MaxTopK": 50,
    "MaxQueries": 20,
    "MaxQueryLength": 2000
  },
  "AllowedHosts": "*"
}
