<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fetching Infrastructure: SSRF-guarded HTTP downloader, robots policy, domain throttle,
    AngleSharp HTML extractor, and Postgres repository + schema script.
  -->
  <PropertyGroup>
    <RootNamespace>Research.Fetching.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Research.Fetching.Application\Research.Fetching.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\Research.Shared.Adapters\Research.Shared.Adapters.csproj" />
    <ProjectReference Include="..\..\..\Providers\Research.Providers.Postgres\Research.Providers.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Persistence\db\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
