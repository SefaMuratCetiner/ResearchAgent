{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Research.Content.Llm": "Information",
        "Research.Content.Reports": "Information"
      }
    }
  },
  "ContentLogging": {
    "MaxChars": 64000
  },
  "Messaging": {
    "ServiceName": "synthesis",
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 10, 60, 300 ],
    "Prefetch": 2,
    "MessageTimeoutSeconds": 900
  },
  "RabbitMq": {
    "Exchange": "research.events",
    "ShutdownDrainSeconds": 120
  },
  "Anthropic": {
    "MaxConcurrentRequests": 2,
    "RefusalFallbackModel": "claude-sonnet-5"
  },
  "Synthesis": {
    "Model": "claude-sonnet-5-5",
    "Effort": "Medium",
    "MaxTokens": 16000,
    "MaxContextChars": 120000,
    "KnowledgeBaseAddress": "https+http://knowledge"
  },
  "AllowedHosts": "*"
}
