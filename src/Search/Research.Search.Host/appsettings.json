{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Research.Content.Llm": "Information",
        "Research.Content.Search": "Information"
      }
    }
  },
  "ContentLogging": {
    "MaxChars": 64000
  },
  "Messaging": {
    "ServiceName": "search",
    "MaxAttempts": 4,
    "RetryDelaysSeconds": [ 10, 60, 300 ],
    "Prefetch": 4,
    "MessageTimeoutSeconds": 600
  },
  "RabbitMq": {
    "Exchange": "research.events",
    "ShutdownDrainSeconds": 60
  },
  "AnthropicWebSearch": {
    "Model": "claude-sonnet-5-5",
    "MaxUses": 3,
    "MaxTokens": 4000,
    "AllowedDomains": [],
    "BlockedDomains": []
  },
  "Search": {
    "MaxResults": 10,
    "CacheTimeToLive": "06:00:00",
    "MaxConcurrentSearches": 4
  },
  "AllowedHosts": "*"
}
