<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ISearchProvider on Anthropic's server-side web search tool: Claude runs the searches, and the result blocks give
    the URLs, titles and page ages. Result-block parsing is isolated in WebSearchResultReader.
  -->
  <PropertyGroup>
    <RootNamespace>Research.Search.AnthropicWebSearch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Research.Search\Research.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
