<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply chain (OWASP ASI04, LLM03): one package source, and every package ID mapped to it, so a package can never be
  resolved from a machine-level feed someone added (dependency confusion). Versions are pinned centrally in
  Directory.Packages.props, restores are locked (packages.lock.json) and audited (NuGetAudit in Directory.Build.props).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
