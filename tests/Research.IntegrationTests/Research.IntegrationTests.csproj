<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Adapters against real infrastructure in containers (Testcontainers; needs Docker): Postgres with pgvector and the
    real schema scripts, and RabbitMQ with the real listener, retry topology and dispatcher.
  -->
  <PropertyGroup>
    <RootNamespace>Research.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic host, DI, logging and metrics for running the RabbitMQ listener as in production. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Research.Messaging\Research.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Providers\Research.Providers.Postgres\Research.Providers.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Providers\Research.Providers.RabbitMq\Research.Providers.RabbitMq.csproj" />
    <ProjectReference Include="..\..\src\Fetching\Research.Fetching.Postgres\Research.Fetching.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Knowledge\Research.Knowledge.Postgres\Research.Knowledge.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Providers\Research.Providers.MockEmbeddings\Research.Providers.MockEmbeddings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
</Project>
